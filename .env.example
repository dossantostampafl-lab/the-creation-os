# Canonical local/development example.
# Render production uses render.yaml plus managed service references and platform secrets.
APP_ENV=development
APP_SECRET_KEY=replace-me-with-a-secure-random-value
CREATOR_BOOTSTRAP_USERNAME=creator
CREATOR_BOOTSTRAP_PASSWORD=change-me-securely
SOVEREIGN_CREATOR_ID=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=1440
LOGIN_MAX_FAILURES=10
LOGIN_FAILURE_WINDOW_SECONDS=300
# Local Docker Compose URLs. Do not copy these values into Render.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/the_creation_os
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:3000
# fake providers are test/development defaults only. Render requires explicit operational provider values.
LLM_PROVIDER=fake
LLM_MODEL=fake
LLM_API_KEY=
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=
FREELLMAPI_BASE_URL=http://freellmapi:3001/v1
FREELLMAPI_TIMEOUT_SECONDS=60
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_BASE_URL=http://ollama:11434/v1
OPENAI_COMPATIBLE_TIMEOUT_SECONDS=60
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=fake
# Optional THE CREATION OS -> PROTO safe bridge. Production requires an HTTPS origin.
# Keep the shared secret in the deployment secret store; never put a real secret in this file.
PROTO_BASE_URL=
PROTO_CREATION_SHARED_SECRET=
PROTO_TIMEOUT_SECONDS=10

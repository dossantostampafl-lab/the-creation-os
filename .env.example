# Canonical local-workstation / LAN runtime.
# Copy to .env. The Docker Compose stack is the supported runtime for THE CREATION OS.
# The UI is exposed on the host LAN at http://<COMPUTER_LAN_IP>:8080 by default.
# PostgreSQL and Redis remain private to the Docker network.
APP_ENV=development
APP_SECRET_KEY=replace-me-with-a-secure-random-value
CREATOR_BOOTSTRAP_USERNAME=creator
CREATOR_BOOTSTRAP_PASSWORD=change-me-securely
SOVEREIGN_CREATOR_ID=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=1440
LOGIN_MAX_FAILURES=10
LOGIN_FAILURE_WINDOW_SECONDS=300
# Docker-internal service URLs.
# A senha do Postgres local. Em um servidor exposto à internet, o install.sh gera uma senha
# forte na primeira instalação e reescreve as duas linhas abaixo; não deixe 'postgres' lá.
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/the_creation_os
REDIS_URL=redis://redis:6379/0
CORS_ALLOW_ORIGINS=http://localhost:8080
# fake is the safe bootstrap default: nothing leaves this computer and no plan or key is used.
# Switch to a real provider for operational inference (deploy/oracle/set-inference.sh does this
# on Oracle). Supported providers: chatgpt, openai, anthropic, freellmapi, openai_compatible.
LLM_PROVIDER=fake
# Optional reserve chain; it must not repeat LLM_PROVIDER. With LLM_PROVIDER=chatgpt it is used only
# when CHATGPT_FALLBACK_ENABLED=true, and then never silently: each reply from a reserve names the
# provider that answered and why.
LLM_FALLBACK_PROVIDERS=
LLM_MODEL=fake
LLM_API_KEY=
# Optional: Sign in with ChatGPT (plan OAuth). Only read when LLM_PROVIDER=chatgpt, which must be
# the explicit primary. Credentials live outside source control in the protected
# chatgpt_credentials volume and are refreshed in place. Defaults shown:
# CHATGPT_MODEL=gpt-6.1-sol
# CHATGPT_CREDENTIALS_FILE=/var/lib/creation/chatgpt/credentials.json
# CHATGPT_BASE_URL=https://api.openai.com/v1
# CHATGPT_TIMEOUT_SECONDS=60
# Required when ChatGPT participates in autonomous discovery/competition. Keep false unless the user explicitly consents.
CHATGPT_BACKGROUND_AUTOMATION_CONSENT=false
# Opt-in disclosed reserve: with LLM_FALLBACK_PROVIDERS=freellmapi, a request the ChatGPT plan cannot
# answer continues on FreeLLMAPI and the reply is labeled with the provider that answered and why.
CHATGPT_FALLBACK_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_TIMEOUT_SECONDS=60
ANTHROPIC_MAX_OUTPUT_TOKENS=4096
# Leave empty when the gateway needs no key: requests are then sent without an Authorization header.
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=
# FreeLLMAPI runs outside this Compose stack (Windows app or its own container on port 3001);
# host.docker.internal lets the api/worker containers reach it on this computer.
FREELLMAPI_BASE_URL=http://host.docker.internal:3001/v1
FREELLMAPI_TIMEOUT_SECONDS=60
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_BASE_URL=http://ollama:11434/v1
OPENAI_COMPATIBLE_TIMEOUT_SECONDS=60
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=fake
# Semantic cache rollout: shadow -> exact -> semantic after validation.
SEMANTIC_CACHE_MODE=shadow
SEMANTIC_CACHE_POLICY_VERSION=sc-v1
SEMANTIC_CACHE_EMBEDDING_VERSION=v1
SEMANTIC_CACHE_REDIS_PREFIX=tco:semantic-cache
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.94
SEMANTIC_CACHE_REVALIDATE_THRESHOLD=0.90
SEMANTIC_CACHE_MAX_CANDIDATES=5
SEMANTIC_CACHE_TTL_SECONDS=86400
SEMANTIC_CACHE_DOCUMENT_TTL_SECONDS=3600
SEMANTIC_CACHE_DETERMINISTIC_TTL_SECONDS=3600
SEMANTIC_CACHE_LOCK_SECONDS=30
SEMANTIC_CACHE_SINGLEFLIGHT_WAIT_MS=250
# The Trinity stays on the governed execution path. Ordinary conversation and read-only questions
# go directly to DEUS for low latency; action requests still pass through SOPHIA/ROCKMAM and a viable
# plan becomes a validated Mission that waits for the Creator's "autoriza".
TRINITY_ENABLED=true
TRINITY_MIN_CONFIDENCE=0.7
# Interactive DEUS chat bounds. A stalled primary is cut early so the configured
# reserve still has time to answer before the whole chat request is abandoned.
DEUS_CHAT_PROVIDER_TIMEOUT_SECONDS=5
DEUS_CHAT_TOTAL_TIMEOUT_SECONDS=15
# ChatGPT-plan attempts get their own deadline (a reply counts only after response.completed);
# when chatgpt is in the chain the whole-turn ceiling is TOTAL + this value.
DEUS_CHAT_CHATGPT_TIMEOUT_SECONDS=25
# What an Agent can actually do. The workspace gives each Mission its own directory under
# WORKSPACE_ROOT and nothing outside it; the web capability reads public pages only — an address
# on the loopback interface, a private range or the cloud metadata service is always refused.
# No Docker, este caminho é o volume workspace_data e já pertence ao usuário da imagem; se você
# mudar WORKSPACE_ROOT, garanta que o diretório exista com o dono correto (uid 10001).
WORKSPACE_ROOT=/var/lib/creation/workspaces
WORKSPACE_MAX_BYTES=1000000
WEB_CAPABILITY_ENABLED=true
WEB_TIMEOUT_SECONDS=15
WEB_MAX_BYTES=500000
# Local Kokoro pm_santa + Vosk Portuguese, enabled after model preparation.
# Run the Deploy task set-local-voice; fresh installs remain bootable without models.
VOICE_SESSION_TICKET_TTL_SECONDS=20
DEUS_LOCAL_VOICE_MODELS_DIR=/var/lib/creation/voice
DEUS_LOCAL_VOICE_SILENCE_MS=400
DEUS_LOCAL_VOICE_CPU_THREADS=2
DEUS_VOICE_SESSION_ENABLED=false
DEUS_VOICE_PRIMARY_PROVIDER=chatgpt
# Optional ordered pool used only by DEUS realtime voice. Leave empty to preserve the
# legacy FREELLMAPI_MODEL behavior. Never put "auto" here: list only conversational
# models already validated for instruction-following and latency.
DEUS_VOICE_CONVERSATION_MODELS=
DEUS_VOICE_FIRST_TOKEN_TIMEOUT_MS=2500
# Optional THE CREATION OS -> PROTO safe bridge.
# For PROTO running on the same computer, use host.docker.internal as the host.
# Keep real shared secrets only in your untracked .env file.
PROTO_BASE_URL=
PROTO_CREATION_SHARED_SECRET=
PROTO_TIMEOUT_SECONDS=10

# Security Task Force (docker compose --profile security-task-force). Required for that profile only.
# Shared secret between the Authorization Plane and the gateway; 32+ random characters.
STF_GATEWAY_SIGNING_KEY=
# Privileged execution stays disabled unless the host provides Kata or Firecracker.
STF_SANDBOX_BACKEND=auto
# Environment prefixes the gateway will ever execute in. Real environments are off by default.
STF_ALLOWED_ENVIRONMENTS=cyber_range:
# Automatic training is range-only and must be enabled explicitly on the host.
STF_AUTO_TRAINING_ENABLED=false
STF_AUTO_TRAINING_CYCLE_SECONDS=60

# Optional telemetry (docker compose --profile observability). Grafana listens on 127.0.0.1 only.
STF_GRAFANA_ADMIN_PASSWORD=
STF_GRAFANA_PORT=3300

# Connected DEUS: enable after migrations/backup; run --profile connected-deus.
DEUS_KNOWLEDGE_INGESTION_ENABLED=false
DEUS_CONTEXT_RETRIEVAL_ENABLED=false
DEUS_DIAGNOSTICS_ENABLED=false
DEUS_AUTONOMY_DISCOVERY_ENABLED=false
DEUS_AUTONOMY_COMPETITION_ENABLED=false
OPPORTUNITY_COMPETITOR_LIMIT=3
OPPORTUNITY_COMPOSITION_ENABLED=true
OPPORTUNITY_MAX_PER_CYCLE=2
OPPORTUNITY_RESEARCH_LEASE_SECONDS=600
OPPORTUNITY_EXECUTIVE_LEASE_SECONDS=1800
OPPORTUNITY_STALE_CLAIM_SECONDS=900
OPPORTUNITY_COMPETITION_CYCLE_SECONDS=60
# After a cycle in which no inference provider answered, the next wait doubles, up to this ceiling.
OPPORTUNITY_INFERENCE_BACKOFF_MAX_SECONDS=1800
# Perception Fabric authority is separate from Universe priors. Bindings map symbolic sensors to logical capabilities;
# only sensors named in PERCEPTION_SENSOR_ALLOWLIST may run before a Mission, and material capabilities are refused.
PERCEPTION_SENSOR_BINDINGS_JSON={"web.search":{"capability":"web","action":"search"}}
PERCEPTION_SENSOR_ALLOWLIST=web.search
PERCEPTION_MAX_SENSORS_PER_CYCLE=4
DEUS_OBSIDIAN_EXPORT_ENABLED=false
DEUS_OBSIDIAN_ROOT=/var/lib/creation/obsidian
DEUS_DIAGNOSTICS_ROOT=/var/lib/creation/diagnostics
DEUS_DIAGNOSTICS_TASK_STALL_SECONDS=900
DEUS_DIAGNOSTICS_PROJECTION_MAX_LAG=100
# Private host relay; never a public Cyber Range endpoint. See docs/connected-os.md.
# The Rust STF gateway uses host:port; the connected-OS client may use the controller URL separately.
CYBER_RANGE_CONTROL_ADDR=host.docker.internal:7071
CYBER_RANGE_CONTROLLER_URL=
CYBER_RANGE_CONTROL_TOKEN=

MCP_SERVERS_JSON=[]
MCP_TIMEOUT_SECONDS=15
# Private observability (activate with deploy/oracle/enable-observability.sh).
TELEMETRY_ENABLED=false
TELEMETRY_OTLP_ENDPOINT=http://otel-collector:4318
TELEMETRY_SAMPLE_RATIO=1.0

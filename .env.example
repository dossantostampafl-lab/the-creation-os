# Canonical local-workstation / LAN runtime.
# Copy to .env. The Docker Compose stack is the supported runtime for THE CREATION OS.
# The UI is exposed on the host LAN at http://<COMPUTER_LAN_IP>:8080 by default.
# PostgreSQL and Redis remain private to the Docker network.
APP_ENV=development
APP_SECRET_KEY=replace-me-with-a-secure-random-value
CREATOR_BOOTSTRAP_USERNAME=creator
CREATOR_BOOTSTRAP_PASSWORD=change-me-securely
SOVEREIGN_CREATOR_ID=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=1440
LOGIN_MAX_FAILURES=10
LOGIN_FAILURE_WINDOW_SECONDS=300
# Docker-internal service URLs.
# A senha do Postgres local. Em um servidor exposto à internet, o install.sh gera uma senha
# forte na primeira instalação e reescreve as duas linhas abaixo; não deixe 'postgres' lá.
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/the_creation_os
REDIS_URL=redis://redis:6379/0
CORS_ALLOW_ORIGINS=http://localhost:8080
# fake providers are safe bootstrap defaults only. For operational local inference,
# select openai, anthropic, freellmapi, or openai_compatible and supply the corresponding settings.
LLM_PROVIDER=fake
# Optional ordered fallback chain used when the primary provider is unavailable,
# rate-limited or in circuit-open state. Example: LLM_PROVIDER=freellmapi with
# LLM_FALLBACK_PROVIDERS=anthropic. Every listed provider must be fully configured.
LLM_FALLBACK_PROVIDERS=
LLM_MODEL=fake
LLM_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_TIMEOUT_SECONDS=60
ANTHROPIC_MAX_OUTPUT_TOKENS=4096
# Leave empty when the gateway needs no key: requests are then sent without an Authorization header.
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=
# FreeLLMAPI runs outside this Compose stack (Windows app or its own container on port 3001);
# host.docker.internal lets the api/worker containers reach it on this computer.
FREELLMAPI_BASE_URL=http://host.docker.internal:3001/v1
FREELLMAPI_TIMEOUT_SECONDS=60
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_BASE_URL=http://ollama:11434/v1
OPENAI_COMPATIBLE_TIMEOUT_SECONDS=60
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=fake
# Semantic cache rollout: shadow -> exact -> semantic after validation.
SEMANTIC_CACHE_MODE=shadow
SEMANTIC_CACHE_POLICY_VERSION=sc-v1
SEMANTIC_CACHE_EMBEDDING_VERSION=v1
SEMANTIC_CACHE_REDIS_PREFIX=tco:semantic-cache
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.94
SEMANTIC_CACHE_REVALIDATE_THRESHOLD=0.90
SEMANTIC_CACHE_MAX_CANDIDATES=5
SEMANTIC_CACHE_TTL_SECONDS=86400
SEMANTIC_CACHE_DOCUMENT_TTL_SECONDS=3600
SEMANTIC_CACHE_DETERMINISTIC_TTL_SECONDS=3600
SEMANTIC_CACHE_LOCK_SECONDS=30
SEMANTIC_CACHE_SINGLEFLIGHT_WAIT_MS=250
# The Trinity stays on the governed execution path. Ordinary conversation and read-only questions
# go directly to DEUS for low latency; action requests still pass through SOPHIA/ROCKMAM and a viable
# plan becomes a validated Mission that waits for the Creator's "autoriza".
TRINITY_ENABLED=true
TRINITY_MIN_CONFIDENCE=0.7
# What an Agent can actually do. The workspace gives each Mission its own directory under
# WORKSPACE_ROOT and nothing outside it; the web capability reads public pages only — an address
# on the loopback interface, a private range or the cloud metadata service is always refused.
# No Docker, este caminho é o volume workspace_data e já pertence ao usuário da imagem; se você
# mudar WORKSPACE_ROOT, garanta que o diretório exista com o dono correto (uid 10001).
WORKSPACE_ROOT=/var/lib/creation/workspaces
WORKSPACE_MAX_BYTES=1000000
WEB_CAPABILITY_ENABLED=true
WEB_TIMEOUT_SECONDS=15
WEB_MAX_BYTES=500000
# Local Kokoro pm_santa + Vosk Portuguese, enabled after model preparation.
# Run the Deploy task set-local-voice; fresh installs remain bootable without models.
VOICE_SESSION_TICKET_TTL_SECONDS=20
DEUS_LOCAL_VOICE_MODELS_DIR=/var/lib/creation/voice
DEUS_LOCAL_VOICE_SILENCE_MS=400
DEUS_LOCAL_VOICE_CPU_THREADS=2
DEUS_VOICE_SESSION_ENABLED=false
DEUS_VOICE_PRIMARY_PROVIDER=freellmapi
DEUS_VOICE_FIRST_TOKEN_TIMEOUT_MS=2500
# Optional THE CREATION OS -> PROTO safe bridge.
# For PROTO running on the same computer, use host.docker.internal as the host.
# Keep real shared secrets only in your untracked .env file.
PROTO_BASE_URL=
PROTO_CREATION_SHARED_SECRET=
PROTO_TIMEOUT_SECONDS=10

# Security Task Force (docker compose --profile security-task-force). Required for that profile only.
# Shared secret between the Authorization Plane and the gateway; 32+ random characters.
STF_GATEWAY_SIGNING_KEY=
# Privileged execution stays disabled unless the host provides Kata or Firecracker.
STF_SANDBOX_BACKEND=auto
# Environment prefixes the gateway will ever execute in. Real environments are off by default.
STF_ALLOWED_ENVIRONMENTS=cyber_range:

# Optional telemetry (docker compose --profile observability). Grafana listens on 127.0.0.1 only.
STF_GRAFANA_ADMIN_PASSWORD=
STF_GRAFANA_PORT=3001

# Canonical local-workstation / LAN runtime.
# Copy to .env. The Docker Compose stack is the supported runtime for THE CREATION OS.
# The UI is exposed on the host LAN at http://<COMPUTER_LAN_IP>:8080 by default.
# PostgreSQL and Redis remain private to the Docker network.
APP_ENV=development
APP_SECRET_KEY=replace-me-with-a-secure-random-value
CREATOR_BOOTSTRAP_USERNAME=creator
CREATOR_BOOTSTRAP_PASSWORD=change-me-securely
SOVEREIGN_CREATOR_ID=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=1440
LOGIN_MAX_FAILURES=10
LOGIN_FAILURE_WINDOW_SECONDS=300
# Docker-internal service URLs.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/the_creation_os
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:8080
# fake providers are safe bootstrap defaults only. For operational local inference,
# select anthropic, openai, freellmapi, or openai_compatible and supply the corresponding settings.
# Claude (recommended for DEUS): LLM_PROVIDER=anthropic, LLM_MODEL=claude-opus-5, ANTHROPIC_API_KEY=<your key>.
LLM_PROVIDER=fake
LLM_MODEL=fake
LLM_API_KEY=
ANTHROPIC_API_KEY=
# Optional: request timeout, output cap, effort (low|medium|high|xhigh|max) and the
# server-side refusal fallback (default|off; applies to claude-opus-5 / claude-fable-5-1).
ANTHROPIC_TIMEOUT_SECONDS=120
ANTHROPIC_MAX_OUTPUT_TOKENS=16000
ANTHROPIC_EFFORT=
ANTHROPIC_REFUSAL_FALLBACK=default
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=
FREELLMAPI_BASE_URL=http://freellmapi:3001/v1
FREELLMAPI_TIMEOUT_SECONDS=60
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_BASE_URL=http://ollama:11434/v1
OPENAI_COMPATIBLE_TIMEOUT_SECONDS=60
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=fake
# Semantic cache rollout: shadow -> exact -> semantic after validation.
SEMANTIC_CACHE_MODE=shadow
SEMANTIC_CACHE_POLICY_VERSION=sc-v1
SEMANTIC_CACHE_EMBEDDING_VERSION=v1
SEMANTIC_CACHE_REDIS_PREFIX=tco:semantic-cache
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.94
SEMANTIC_CACHE_REVALIDATE_THRESHOLD=0.90
SEMANTIC_CACHE_MAX_CANDIDATES=5
SEMANTIC_CACHE_TTL_SECONDS=86400
SEMANTIC_CACHE_DOCUMENT_TTL_SECONDS=3600
SEMANTIC_CACHE_DETERMINISTIC_TTL_SECONDS=3600
SEMANTIC_CACHE_LOCK_SECONDS=30
SEMANTIC_CACHE_SINGLEFLIGHT_WAIT_MS=250
# Optional THE CREATION OS -> PROTO safe bridge.
# For PROTO running on the same computer, use host.docker.internal as the host.
# Keep real shared secrets only in your untracked .env file.
PROTO_BASE_URL=
PROTO_CREATION_SHARED_SECRET=
PROTO_TIMEOUT_SECONDS=10

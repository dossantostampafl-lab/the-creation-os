APP_ENV=development
APP_SECRET_KEY_FILE=secrets/app_secret_key.txt
CREATOR_BOOTSTRAP_USERNAME=creator
CREATOR_BOOTSTRAP_PASSWORD_FILE=secrets/creator_bootstrap_password.txt
SOVEREIGN_CREATOR_ID=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=1440
LOGIN_RATE_LIMIT_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL_FILE=secrets/database_url.txt
TEST_DATABASE_URL=postgresql+asyncpg://postgres:replace-test-password@localhost:5432/the_creation_os_test
REDIS_URL=redis://redis:6379/0
LOG_LEVEL=INFO
LLM_PROVIDER=fake
LLM_MODEL=fake
LLM_API_KEY_FILE=secrets/llm_api_key.txt
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=fake
GITHUB_TOKEN_FILE=secrets/github_token.txt
GITHUB_ALLOWED_REPOSITORIES=
GITHUB_ALLOWED_ORGANIZATIONS=
OPPORTUNITY_MIN_SCORE=0.45
OPPORTUNITY_MIN_SOURCE_RELIABILITY=0.50
OPPORTUNITY_EXPIRATION_HOURS=72
OPPORTUNITY_MIN_EVIDENCE=1
OPPORTUNITY_ENABLED_UNIVERSES=finance,technology,business
PERCEPTION_ENABLED=true
PERCEPTION_MIN_INTERVAL_SECONDS=300
PERCEPTION_DEFAULT_INTERVAL_SECONDS=900
PERCEPTION_REQUEST_TIMEOUT_SECONDS=10
PERCEPTION_MAX_RETRIES=2
PERCEPTION_FAILURE_THRESHOLD=5
PERCEPTION_SUSPEND_SECONDS=1800
PERCEPTION_FINANCIAL_SYMBOLS=AAPL
PERCEPTION_TECHNOLOGY_REPOSITORIES=openai/openai-python
PERCEPTION_ENABLED_UNIVERSES=finance,technology
PERCEPTION_ALLOWED_HOSTS=query1.finance.yahoo.com,api.github.com
OPPORTUNITY_NOTIFICATION_MIN_SCORE=0.70
OPPORTUNITY_NOTIFICATION_MIN_CONFIDENCE=0.65
OPPORTUNITY_NOTIFICATION_MAX_RISK=0.80
OPPORTUNITY_NOTIFICATION_COOLDOWN_SECONDS=21600
ELEVENLABS_ENABLED=false
ELEVENLABS_API_KEY_FILE=secrets/elevenlabs_api_key.txt
ELEVENLABS_VOICE_ID=configured-voice-id
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Local dev only. In production this must be an https:// URL — the token is sent
# as a Bearer header and the nginx CSP (connect-src) only allows https backends.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
VITE_CREATOR_DEFAULT_USERNAME=creator
# Optional local-only convenience. VITE_* values are public in browser bundles.
VITE_CREATOR_DEV_PASSWORD=
